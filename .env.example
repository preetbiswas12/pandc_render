# ============================================
# Supabase Database
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# App Configuration
# ============================================
VITE_APP_NAME="P&C Texfab"
VITE_APP_URL=https://pandctexfab.com
VITE_CURRENCY_SYMBOL=₹
VITE_CURRENCY_CODE=INR

# ============================================
# Admin Configuration
# ============================================
VITE_ADMIN_EMAIL=admin@pandctexfab.com
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# ============================================
# Payment Gateway (Razorpay - public key only)
# ============================================
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# ============================================
# Business Info
# ============================================
VITE_BUSINESS_EMAIL=contact@pandctexfab.com
VITE_BUSINESS_PHONE=+91-1234-567-890
VITE_BUSINESS_ADDRESS="123 Fabric Street, Fashion City, FC 12345"

# ============================================
# Shipping
# ============================================
VITE_FREE_SHIPPING_THRESHOLD=2000
VITE_STANDARD_SHIPPING_COST=100
VITE_EXPRESS_SHIPPING_COST=200

# ============================================
# Tax
# ============================================
VITE_TAX_RATE=0
VITE_GST_NUMBER=

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_CHAT_SUPPORT=true

# ============================================
# Social Media
# ============================================
VITE_FACEBOOK_URL=https://facebook.com/fabricstore
VITE_INSTAGRAM_URL=https://instagram.com/fabricstore
VITE_TWITTER_URL=https://twitter.com/fabricstore
VITE_WHATSAPP_NUMBER=

# ============================================
# Analytics (optional)
# ============================================
VITE_GOOGLE_ANALYTICS_ID=
VITE_FACEBOOK_PIXEL_ID=

# ============================================
# Development
# ============================================
VITE_DEBUG_MODE=false
VITE_MOCK_PAYMENTS=false
